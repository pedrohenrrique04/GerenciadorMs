<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="sideMenu"
      fx:controller="controller.MenuLateralController"
      prefWidth="220.0" maxWidth="240.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      style="-fx-background-color: #0F172A;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 25, 0.5, 0, 0);
             -fx-border-color: #1E293B;
             -fx-border-width: 0 1 0 0;">

    <padding>
        <Insets top="25" bottom="25"/>
    </padding>

    <!-- TÍTULO -->
    <VBox alignment="CENTER" style="-fx-padding: 0 0 20 0;">
        <Label text="MENU"
               style="-fx-text-fill: #F8FAFC; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    </VBox>

    <!-- BOTÕES PRINCIPAIS -->
    <VBox spacing="8" style="-fx-padding: 10 0 0 0;">

        <Button fx:id="btnDashboard" text="📊  DASHBOARD" prefWidth="220"
                onAction="#abrirDashboard"
                style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20;
                   -fx-font-size: 13px; -fx-font-weight: 600;
                   -fx-background-color: transparent;
                   -fx-alignment: CENTER_LEFT; -fx-border-color: transparent;
                   -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;"/>

        <Button fx:id="btnVendas" text="💰  REALIZAR VENDAS" prefWidth="220"
                onAction="#abrirVendas"
                style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20;
                   -fx-font-size: 13px; -fx-font-weight: 600;
                   -fx-background-color: transparent;
                   -fx-alignment: CENTER_LEFT; -fx-border-color: transparent;
                   -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;"/>

        <Button fx:id="btnProdutos" text="📦  PRODUTOS" prefWidth="220"
                onAction="#abrirProdutos"
                style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20;
                   -fx-font-size: 13px; -fx-font-weight: 600;
                   -fx-background-color: transparent;
                   -fx-alignment: CENTER_LEFT; -fx-border-color: transparent;
                   -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;"/>

        <Button fx:id="btnTroca" text="🔄  TROCA / DEVOLUÇÃO" prefWidth="220"
                onAction="#abrirTroca"
                style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20;
                   -fx-font-size: 13px; -fx-font-weight: 600;
                   -fx-background-color: transparent;
                   -fx-alignment: CENTER_LEFT; -fx-border-color: transparent;
                   -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;"/>

        <Button fx:id="btnRelatorios" text="📈  RELATÓRIOS" prefWidth="220"
                onAction="#abrirRelatorios"
                style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20;
                   -fx-font-size: 13px; -fx-font-weight: 600;
                   -fx-background-color: transparent;
                   -fx-alignment: CENTER_LEFT; -fx-border-color: transparent;
                   -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;"/>

        <Button fx:id="btnNotificacoes" text="🔔  NOTIFICAÇÕES" prefWidth="220"
                onAction="#abrirNotificacoes"
                style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20;
                   -fx-font-size: 13px; -fx-font-weight: 600;
                   -fx-background-color: transparent;
                   -fx-alignment: CENTER_LEFT; -fx-border-color: transparent;
                   -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;"/>

        <Button fx:id="btnPerfil" text="👤  PERFIL" prefWidth="220"
                onAction="#abrirPerfil"
                style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20;
                   -fx-font-size: 13px; -fx-font-weight: 600;
                   -fx-background-color: transparent;
                   -fx-alignment: CENTER_LEFT; -fx-border-color: transparent;
                   -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;"/>
    </VBox>


    <Region VBox.vgrow="ALWAYS"/>

    <!-- BOTÃO DE SAIR -->
    <VBox style="-fx-padding: 20 15 0 15;">
        <Button text="🚪 SAIR" prefWidth="220"
                style="-fx-text-fill: #FCA5A5; -fx-padding: 12 20;
                       -fx-font-size: 13px; -fx-font-weight: 600;
                       -fx-background-color: transparent;
                       -fx-alignment: CENTER_LEFT; -fx-border-color: transparent;
                       -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;"/>
    </VBox>

</VBox>
