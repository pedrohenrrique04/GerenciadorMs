<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="sideMenu"
      prefWidth="220.0" maxWidth="240.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      style="-fx-background-color: #0F172A;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 25, 0.5, 0, 0);
             -fx-border-color: #1E293B;
             -fx-border-width: 0 1 0 0;">

    <padding>
        <Insets top="25" bottom="25"/>
    </padding>

    <!-- TÍTULO -->
    <VBox alignment="CENTER" style="-fx-padding: 0 0 20 0;">
        <Label text="MENU"
               style="-fx-text-fill: #F8FAFC; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    </VBox>

    <!-- BOTÕES PRINCIPAIS -->

    <Region VBox.vgrow="ALWAYS"/>

    <!-- BOTÃO DE SAIR -->
    <VBox style="-fx-padding: 20 15 0 15;">
        <Button text="🚪 SAIR" prefWidth="220"
                style="-fx-text-fill: #FCA5A5; -fx-padding: 12 20;
                       -fx-font-size: 13px; -fx-font-weight: 600;
                       -fx-background-color: transparent;
                       -fx-alignment: CENTER_LEFT; -fx-border-color: transparent;
                       -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;"/>
    </VBox>

</VBox>
