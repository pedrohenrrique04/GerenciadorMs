<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.TrocaDevolucaoController"
            style="-fx-background-color: #f0f2f5;"> <!-- Cor de fundo suave -->

    <top>
        <VBox style="-fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0; -fx-background-color: white;">
            <Label text="SOLICITAÇÃO DE TROCA / DEVOLUÇÃO"
                   style="-fx-font-weight: bold; -fx-font-size: 24; -fx-text-fill: #343a40;">
                <padding>
                    <Insets top="20" bottom="10" left="20" />
                </padding>
            </Label>

            <!-- Área de Status e ID -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <padding>
                    <Insets bottom="10" left="20" />
                </padding>
                <!-- idLabelContainer (VBox) e idTextLabel (Label) para a correção do tipo -->
                <VBox fx:id="idLabelContainer">
                    <Text text="ID da Solicitação:" style="-fx-font-size: 10; -fx-fill: #6c757d;" />
                    <Label fx:id="idTextLabel" text="NOVO"
                           style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #007bff;" />
                </VBox>
                <Label fx:id="nomeProdutoLabel" text="Produto: [Nome do Produto]"
                       style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #495057;" />
                <Label fx:id="precoLabel" text="Valor: R$ 0.00"
                       style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #28a745;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <!-- SplitPane para dividir entre Informações do Pedido e Detalhes do Produto -->
        <SplitPane dividerPositions="0.6" BorderPane.alignment="CENTER" style="-fx-background-color: transparent;">

            <!-- Lado Esquerdo: Detalhes da Solicitação -->
            <VBox spacing="20" style="-fx-background-color: white;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <Label text="DADOS DA SOLICITAÇÃO" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #343a40;" />

                <GridPane vgap="15" hgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="30" />
                        <ColumnConstraints percentWidth="70" />
                    </columnConstraints>

                    <!-- Número do Pedido e Busca -->
                    <Label text="Nº do Pedido:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <HBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <TextField fx:id="numeroPedidoField" promptText="000000" HBox.hgrow="ALWAYS" />
                        <!-- CORREÇÃO: Adicionado onAction para buscarPedido -->
                        <Button fx:id="buscarPedidoBtn" text="Buscar" onAction="#buscarPedido" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>

                    <!-- Tipo de Solicitação -->
                    <Label text="Tipo:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <HBox spacing="20" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <RadioButton fx:id="trocaRadio" text="Troca" />
                        <RadioButton fx:id="devolucaoRadio" text="Devolução" />
                    </HBox>

                    <!-- Data da Troca -->
                    <Label text="Data da Solicitação:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <DatePicker fx:id="dataTrocaField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                    <!-- Motivo -->
                    <Label text="Motivo:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <TextField fx:id="motivoField" promptText="Ex: Tamanho errado, Defeito, etc." GridPane.rowIndex="3" GridPane.columnIndex="1" />

                    <!-- Quantidade e Preço (editáveis para ajuste na solicitação) -->
                    <Label text="Quantidade:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <TextField fx:id="quantidadeField" text="1" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                    <Label text="Valor Unitário:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <TextField fx:id="precoVendaField" text="0.00" promptText="Valor do item na venda original" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                </GridPane>

                <VBox spacing="5">
                    <Label text="Observações:" style="-fx-font-weight: bold;" />
                    <TextArea fx:id="observacoesArea" promptText="Detalhes adicionais sobre a solicitação..." prefHeight="100" />
                </VBox>

                <Separator />

                <!-- Botões de Ação da Solicitação -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <!-- CORREÇÃO: Adicionado onAction para excluirSolicitacao -->
                    <Button fx:id="excluirBtn" text="Excluir" onAction="#excluirSolicitacao" />

                    <!-- CORREÇÃO: Adicionado onAction para toggleEdicao -->
                    <Button fx:id="editarBtn" text="Editar" onAction="#toggleEdicao" />

                    <!-- CORREÇÃO: Adicionado onAction para salvarSolicitacao -->
                    <Button fx:id="salvarBtn" text="Salvar" onAction="#salvarSolicitacao" />

                    <!-- CORREÇÃO: Adicionado onAction para processarSolicitacao -->
                    <Button fx:id="processarBtn" text="Processar" onAction="#processarSolicitacao" />

                    <!-- CORREÇÃO: Adicionado onAction para cancelarSolicitacao -->
                    <Button fx:id="cancelarBtn" text="Rejeitar" onAction="#cancelarSolicitacao" />
                </HBox>
            </VBox>

            <!-- Lado Direito: Detalhes do Produto (Somente Leitura) -->
            <VBox spacing="10" style="-fx-background-color: #f8f9fa;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <Label text="INFORMAÇÕES DO PRODUTO (Somente Leitura)"
                       style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #343a40;" />

                <Separator />

                <GridPane vgap="10" hgap="10">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="120" />
                        <ColumnConstraints prefWidth="250" />
                    </columnConstraints>

                    <Label text="Nome:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="nomeField" editable="false" promptText="Nome do Produto" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <Label text="Preço Custo:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <TextField fx:id="precoCustoField" editable="false" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                    <Label text="Data Entrada:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <TextField fx:id="dataEntradaField" editable="false" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                    <Label text="Data Reposição:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <TextField fx:id="dataReposicaoField" editable="false" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                </GridPane>

                <Separator />

                <VBox spacing="5">
                    <Label text="Atributos:" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Text text="Categoria:" style="-fx-font-weight: bold; -fx-fill: #6c757d;"/>
                            <CheckBox fx:id="roupasCheck" text="Roupas" disable="true" />
                            <CheckBox fx:id="calcadosCheck" text="Calçados" disable="true" />
                            <CheckBox fx:id="acessoriosCheck" text="Acessórios" disable="true" />
                        </VBox>
                        <VBox spacing="5">
                            <Text text="Gênero:" style="-fx-font-weight: bold; -fx-fill: #6c757d;"/>
                            <RadioButton fx:id="masculinoRadio" text="Masculino" disable="true" />
                            <RadioButton fx:id="femininoRadio" text="Feminino" disable="true" />
                            <RadioButton fx:id="unisexRadio" text="Unissex" disable="true" />
                        </VBox>
                        <VBox spacing="5">
                            <Text text="Cor:" style="-fx-font-weight: bold; -fx-fill: #6c757d;"/>
                            <CheckBox fx:id="brancoCheck" text="Branco" disable="true" />
                            <CheckBox fx:id="pretoCheck" text="Preto" disable="true" />
                            <CheckBox fx:id="verdeCheck" text="Verde" disable="true" />
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>

        </SplitPane>
    </center>
</BorderPane>