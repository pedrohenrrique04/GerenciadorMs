<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.trocadevolucao.controller.TrocaDevolucaoController"
            style="-fx-background-color: #f4f4f4;">

    <top>
        <VBox alignment="CENTER" style="-fx-background-color: #212529;">
            <Label text="Troca / Devolução"
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 24;">
                <VBox.margin>
                    <Insets top="20" bottom="20" />
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">

            <Tab text="Solicitação e Itens">
                <HBox spacing="30" alignment="TOP_CENTER">
                    <padding>
                        <Insets top="30" right="30" bottom="30" left="30" />
                    </padding>

                    <VBox spacing="20" prefWidth="350">
                        <Label text="Dados da Solicitação" style="-fx-font-weight: bold; -fx-font-size: 16;" />

                        <GridPane vgap="10" hgap="10">
                            <Label text="ID da Solicitação:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="idLabel" text="[ID]" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-weight: bold;" />

                            <Label text="Nº Pedido:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <TextField fx:id="numeroPedidoField" promptText="Número do pedido original" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Button text="Buscar" onAction="#buscarPedido" GridPane.rowIndex="1" GridPane.columnIndex="2" />

                            <Label text="Data:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <DatePicker fx:id="dataTrocaField" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                        </GridPane>

                        <Separator />

                        <Label text="Tipo de Operação" style="-fx-font-weight: bold; -fx-font-size: 14;" />

                        <fx:define>
                            <ToggleGroup fx:id="tipoSolicitacaoGroup" />
                        </fx:define>

                        <HBox spacing="15">
                            <RadioButton fx:id="trocaRadio" text="Troca" toggleGroup="${tipoSolicitacaoGroup}" />
                            <RadioButton fx:id="devolucaoRadio" text="Devolução" toggleGroup="${tipoSolicitacaoGroup}" />
                        </HBox>

                        <Label text="Motivo:" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                        <TextField fx:id="motivoField" promptText="Ex: Defeito, Tamanho incorreto" />

                        <Label text="Observações:" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                        <TextArea fx:id="observacoesArea" prefRowCount="4" promptText="Detalhes da solicitação..." />

                    </VBox>

                    <VBox spacing="20" prefWidth="400">
                        <Label text="Detalhes do Item" style="-fx-font-weight: bold; -fx-font-size: 16;" />

                        <GridPane vgap="10" hgap="10">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="120" />
                                <ColumnConstraints prefWidth="250" />
                            </columnConstraints>

                            <Label text="Produto ID:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="nomeProdutoLabel" text="Produto ID: [99]" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Nome:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <TextField fx:id="nomeField" text="Tênis Nike Air Force" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Quantidade:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <TextField fx:id="quantidadeField" text="1" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                            <Label text="Valor Unitário:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                            <TextField fx:id="precoVendaField" text="R$ 799,99" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                            <Label text="Valor Total:" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                            <Label fx:id="precoLabel" text="R$ 799,99" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #dc3545;" />

                            <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2">
                                <Button fx:id="excluirBtn" text="Excluir" />
                                <Button fx:id="editarBtn" text="Editar" />
                                <Button fx:id="salvarBtn" text="Salvar" />
                            </HBox>
                        </GridPane>
                    </VBox>
                </HBox>
            </Tab>

            <Tab text="Processamento">
                <VBox spacing="20" alignment="CENTER" >
                    <padding>
                        <Insets top="40" right="40" bottom="40" left="40" />
                    </padding>

                    <Label text="Processar Solicitação" style="-fx-font-weight: bold; -fx-font-size: 18;" />

                    <Label text="Ação Final:" style="-fx-font-weight: bold; -fx-font-size: 14;" />

                    <HBox spacing="20" alignment="CENTER">
                        <Button fx:id="processarBtn" text="PROCESSAR E CONCLUIR" prefWidth="200" prefHeight="40" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" onAction="#processarSolicitacao" />
                        <Button fx:id="cancelarBtn" text="CANCELAR" prefWidth="120" prefHeight="40" style="-fx-background-color: #dc3545; -fx-text-fill: white;" onAction="#cancelarSolicitacao" />
                    </HBox>

                    <Separator />

                    <Label text="Status Atual:" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                    <Label text="PENDENTE" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: orange;" />

                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>