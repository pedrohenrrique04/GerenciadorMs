<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.UsuariodashboardController"
            style="-fx-background-color: #F8FAFC;">

    <center>
        <HBox spacing="25" alignment="TOP_CENTER" style="-fx-padding: 25;">

            <VBox prefWidth="500" prefHeight="450" spacing="15"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px;
                         -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0.3, 0, 4);"
                  HBox.hgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📋" style="-fx-font-size: 18px;"/>
                    <Label text="Lista de Usuários"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                </HBox>

                <VBox fx:id="listaUsuariosContainer" spacing="8" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox prefWidth="400" spacing="20"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px;
                         -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0.3, 0, 4);">

                <Label text="Novo Usuário"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />

                <VBox spacing="10">
                    <Label text="Nome" style="-fx-font-size: 13px;" />
                    <TextField fx:id="campoNome" promptText="Digite o nome"
                               style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;" />

                    <Label text="Senha" style="-fx-font-size: 13px;" />
                    <PasswordField fx:id="campoSenha" promptText="Digite a senha"
                                   style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;" />

                    <Label text="Função" style="-fx-font-size: 13px;" />
                    <ComboBox fx:id="comboFuncoes" promptText="Selecione o Tipo"
                              style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;"
                              prefWidth="500" />
                </VBox>

                <HBox alignment="CENTER" spacing="15">
                    <Button text="Salvar Novo" prefWidth="140"
                            onAction="#handleSalvarNovoUsuario"
                            style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />

                    <Button text="Limpar" prefWidth="120"
                            onAction="#handleLimparFormulario"
                            style="-fx-background-color: #94A3B8; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />
                </HBox>
            </VBox>

        </HBox>
    </center>

</BorderPane>