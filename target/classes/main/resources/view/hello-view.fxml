<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardController"
            style="-fx-background-color: #1E293B;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #0F172A; -fx-padding: 12;" prefHeight="60">

            <Label style="-fx-font-size: 20px; -fx-text-fill: #F8FAFC; -fx-cursor: hand;" text="☰"
                   onMouseClicked="#handleMenuToggle" />

            <Region HBox.hgrow="ALWAYS" />

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="Dashboard" />

            <Region HBox.hgrow="ALWAYS" />

        </HBox>
    </top>

    <center>
        <StackPane>

            <BorderPane fx:id="contentArea" style="-fx-background-color: #F8FAFC;">
            </BorderPane>

            <VBox fx:id="sideMenu" prefWidth="220.0" maxWidth="220.0" prefHeight="-1.0"
                  StackPane.alignment="TOP_LEFT"
                  style="-fx-background-color: #0F172A;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 25, 0.5, 0, 0);
                         -fx-border-color: #1E293B;
                         -fx-border-width: 0 1 0 0;">
                <padding>
                    <Insets top="25" bottom="25" />
                </padding>

                <VBox alignment="CENTER" style="-fx-padding: 0 0 20 0;">
                    <Label style="-fx-text-fill: #F8FAFC; -fx-font-size: 18px; -fx-font-weight: bold;" text="MENU" />
                </VBox>

                <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                    <Button style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-border-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;" text="📊 DASHBOARD" onAction="#loadDashboard" prefWidth="220" />
                    <Button style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-border-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;" text="💰 REALIZAR VENDAS" onAction="#loadRealizarVendas" prefWidth="220" />
                    <Button style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-border-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;" text="📦 PRODUTOS" onAction="#loadProdutos" prefWidth="220" />
                    <Button style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-border-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;" text="🔄 TROCA/DEVOLUÇÃO" onAction="#loadTrocaDevolucao" prefWidth="220" />
                    <Button style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-border-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;" text="📈 RELATÓRIOS" onAction="#loadRelatorios" prefWidth="220" />
                    <Button style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-border-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;" text="🔔 NOTIFICAÇÕES" onAction="#loadNotificacoes" prefWidth="220" />
                    <Button style="-fx-text-fill: #E2E8F0; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-border-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;" text="👤 PERFIL" onAction="#loadUsuariosView"  prefWidth="220" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox style="-fx-padding: 20 15 0 15;">
                    <Button style="-fx-text-fill: #FCA5A5; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-border-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-border-radius: 8;" text="🚪 SAIR" prefWidth="220" />
                </VBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>