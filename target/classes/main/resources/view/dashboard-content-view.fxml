<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardController">

    <center>
        <VBox alignment="CENTER" style="-fx-background-color: #F8FAFC; -fx-padding: 20; -fx-spacing: 20;">

            <!-- CARDS SUPERIORES -->
            <HBox spacing="20" alignment="CENTER" prefWidth="800" VBox.vgrow="ALWAYS">

                <VBox fx:id="cardVendasHoje" alignment="CENTER" minHeight="100" prefWidth="350"
                      style="-fx-background-color: linear-gradient(to bottom right, #3B82F6, #1D4ED8);
                             -fx-background-radius: 12px; -fx-padding: 20px;
                             -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 15, 0.3, 0, 4);"
                      HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #EFF6FF; -fx-font-size: 12px; -fx-font-weight: bold;"
                           text="VENDAS DE HOJE" />
                    <Label fx:id="labelVendasHoje"
                           style="-fx-text-fill: #EFF6FF; -fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 8 0 0 0;"
                           text="R$ 9.999,00" />
                </VBox>

                <VBox fx:id="cardVendasMes" alignment="CENTER" minHeight="100" prefWidth="350"
                      style="-fx-background-color: linear-gradient(to bottom right, #10B981, #047857);
                             -fx-background-radius: 12px; -fx-padding: 20px;
                             -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.3), 15, 0.3, 0, 4);"
                      HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #ECFDF5; -fx-font-size: 12px; -fx-font-weight: bold;"
                           text="VENDAS DO MÊS" />
                    <Label fx:id="labelVendasMes"
                           style="-fx-text-fill: #ECFDF5; -fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 8 0 0 0;"
                           text="R$ 9.999,00" />
                </VBox>
            </HBox>

            <!-- MEIO -->
            <HBox spacing="20" alignment="CENTER" prefWidth="800" prefHeight="200" VBox.vgrow="ALWAYS">

                <VBox fx:id="cardMaisVendidos" alignment="TOP_CENTER" prefWidth="350"
                      style="-fx-background-color: linear-gradient(to bottom right, #FEF3C7, #F59E0B);
                             -fx-background-radius: 12px; -fx-padding: 20px;
                             -fx-effect: dropshadow(gaussian, rgba(245, 158, 11, 0.2), 15, 0.3, 0, 4);"
                      HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER" spacing="8">
                        <Label style="-fx-text-fill: #78350F; -fx-font-size: 13px; -fx-font-weight: bold;"
                               text="PRODUTOS MAIS VENDIDOS" />
                    </HBox>

                    <VBox fx:id="listaMaisVendidos" spacing="8" style="-fx-padding: 15 0 0 0; -fx-alignment: CENTER_LEFT;">
                        <Label style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: 500;"
                               text="1. Nike Air Force 1 - quant. 999" />
                        <Label style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: 500;"
                               text="2. Nike Air Force 1 - quant. 999" />
                        <Label style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: 500;"
                               text="3. Produto B - quant. 999" />
                        <Label style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: 500;"
                               text="4. Produto C - quant. 999" />
                    </VBox>
                </VBox>

                <VBox fx:id="cardEstoqueCritico" alignment="TOP_CENTER" prefWidth="350"
                      style="-fx-background-color: linear-gradient(to bottom right, #FECACA, #EF4444);
                             -fx-background-radius: 12px; -fx-padding: 20px;
                             -fx-effect: dropshadow(gaussian, rgba(239, 68, 68, 0.2), 15, 0.3, 0, 4);"
                      HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER" spacing="8">
                        <Label style="-fx-text-fill: #7F1D1D; -fx-font-size: 13px; -fx-font-weight: bold;"
                               text="ESTOQUE CRÍTICO" />
                    </HBox>

                    <VBox fx:id="listaMenosVendidos" spacing="8" style="-fx-padding: 15 0 0 0; -fx-alignment: CENTER_LEFT;">
                        <Label style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: 500;"
                               text="1. Produto X - quant. 5" />
                        <Label style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: 500;"
                               text="2. Produto Y - quant. 3" />
                        <Label style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: 500;"
                               text="3. Produto Z - quant. 2" />
                    </VBox>
                </VBox>

            </HBox>

            <!-- GRAFICO -->
            <HBox alignment="CENTER" prefWidth="900" prefHeight="350" VBox.vgrow="ALWAYS">

                <VBox alignment="CENTER" prefWidth="850"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-padding: 25px;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0.3, 0, 4);"
                      HBox.hgrow="ALWAYS">

                    <HBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 20 0;">
                        <Label text="📈" style="-fx-font-size: 18px;"/>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"
                               text="FATURAMENTO AO LONGO DO TEMPO" />
                    </HBox>

                    <BarChart fx:id="chartFaturamento" legendVisible="false"
                              prefHeight="180" prefWidth="680"
                              style="-fx-background-color: transparent">
                        <xAxis>
                            <CategoryAxis fx:id="xAxis" side="BOTTOM" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxis" side="LEFT" />
                        </yAxis>
                    </BarChart>

                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>