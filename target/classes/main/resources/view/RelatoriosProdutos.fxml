<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>

<?import com.jfoenix.controls.JFXHamburger?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>
<?import com.jfoenix.controls.JFXDrawer?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RelatoriosProdutosController"
            prefWidth="1280" prefHeight="720">
<top>
    <AnchorPane prefHeight="70" prefWidth="1280" style="-fx-background-color: #0F172A;">
        <children>
            <JFXHamburger fx:id="h2" layoutX="20" layoutY="15" prefHeight="40" prefWidth="40" />
            <Label layoutX="570.0" layoutY="20.0" text="Relatórios" textFill="white">
                <font><Font name="Georgia Bold" size="26"/></font>
            </Label>
        </children>
    </AnchorPane>
</top>

    <center>
        <StackPane>
            <JFXDrawer fx:id="drawer02"
                       defaultDrawerSize="240"
                       overLayVisible="true"
                       prefHeight="1080"
                       prefWidth="240"
                       resizableOnDrag="false"/>
            <AnchorPane fx:id="mainContent02" style="-fx-background-color: #F7F7F7;">
                <children>
                    <Label layoutX="30.0" layoutY="21.0" text="Tipo de relatório">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <ComboBox fx:id="comboOpcoes02" layoutX="20.0" layoutY="40.0" prefWidth="160"
                              promptText="Produtos"
                              style="-fx-background-radius: 8; -fx-background-color: #E0E0E0;">

                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Vendas"/>
                                <String fx:value="Produtos"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </children>
            </AnchorPane>
        </StackPane>

    </center>

</BorderPane>
